post_install() {
	systemctl enable liora-drivers.timer >/dev/null 2>&1 || true
	# Waits for this pacman transaction to end. Ignored in a chroot.
	systemctl start --no-block liora-drivers.service >/dev/null 2>&1 || true
}

post_upgrade() {
	post_install
}

pre_remove() {
	systemctl disable liora-drivers.timer >/dev/null 2>&1 || true
}
